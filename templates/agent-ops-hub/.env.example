# Placeholders only. Safe to commit. Never commit secret values.
# A secret manager is the source of truth. Inject values at deploy time.
# Cloudflare secrets are a deploy-time inject, not a second source of truth.
# Do not put real secrets in a local .env file.
#
# Foundation rules (detail in docs/SECURITY_IMPLEMENTATION.md):
# 1. HMAC: verify X-Hub-Signature-256 with a constant-time compare of the
#    HMAC-SHA256 of the raw body BEFORE any JSON parse.
# 2. Concurrent launch: refuse a second job for the same Issue while
#    status-running. This applies to the pull claim and to any push fallback.
# 3. Actor allowlist: ALLOWED_ACTORS below. Logins only, comma-separated.
# 4. Loop prevention: ignore webhook events where this App is the actor,
#    except intentional status updates that do not re-add trigger-run.

# Webhook HMAC secret. Placeholder only. Value lives in a secret manager.
WEBHOOK_SECRET=replace-with-webhook-secret

# GitHub App id and the installation id for your private hub only.
GITHUB_APP_ID=000000
GITHUB_INSTALLATION_ID=000000

# GitHub App bot login without the [bot] suffix. The Worker uses it to ignore
# webhook events whose actor is this App (loop prevention).
GITHUB_APP_SLUG=your-app-bot

# PEM source of truth is a secret manager. Deploy injects it into the
# Cloudflare secret GITHUB_APP_PRIVATE_KEY. This ref is not key material. Do
# not copy the PEM into .env or onto the Mac.
GITHUB_APP_PRIVATE_KEY_REF=op://vault/item/private-key

# Status-proxy shared secret. Placeholder only. Value lives in a secret
# manager.
STATUS_PROXY_SHARED_SECRET=replace-with-status-proxy-secret

# GitHub logins allowed to add trigger-run. Reject every other login,
# including bots. Example only: replace at deploy time, not in git.
ALLOWED_ACTORS=login1,login2

# Repository the App is installed on (selected repository, private hub only).
HUB_REPO=YOUR_HUB_OWNER/YOUR_HUB_REPO

# Public repository whose trigger-run labels must not launch a job.
IGNORED_LAUNCH_REPOS=YOUR_PUBLIC_OWNER/YOUR_PUBLIC_REPO

# Worker base URL for the Mac claim and status calls (Mac launcher).
# Placeholder only. The Worker does not read this value from an Issue.
WORKER_BASE_URL=https://worker.example.invalid

# Seconds between Mac claim polls (Mac launcher). Placeholder only.
CLAIM_POLL_SECONDS=30

# Optional audit id the Mac sends as X-Agent-Id on claim (Mac launcher). Not a
# secret. Example only; the operator picks a label such as mac-1.
# AGENT_ID=mac-1

# Optional Cloudflare Access placeholders. Unused while Mac pull is the
# default (docs/SECURITY_IMPLEMENTATION.md). Do not put a real tunnel
# hostname, Access client secret, or personal email in this file.
# ACCESS_TEAM_DOMAIN=team.example.invalid
# ACCESS_AUD=replace-with-access-audience
# ACCESS_SERVICE_TOKEN_CLIENT_ID=replace-with-client-id
# ACCESS_SERVICE_TOKEN_CLIENT_SECRET=replace-with-client-secret
# LAUNCHER_BASE_URL=https://launcher.example.invalid
